.privacy-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-top: 48rpx;
  padding-right: 40rpx;
  padding-left: 40rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: rgba(28, 36, 48, 0.45);
}

.privacy-panel {
  width: 600rpx;
  max-width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c2430;
  line-height: 1.4;
}

.privacy-desc {
  margin-top: 16rpx;
  color: #3c4654;
  font-size: 28rpx;
  line-height: 1.6;
}

.privacy-link {
  color: #1D4E9E;
  font-size: 28rpx;
  font-weight: 600;
}

.privacy-actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin-top: 28rpx;
}

.privacy-btn {
  flex: 1;
  width: 0;
  height: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border-width: 2rpx;
  border-style: solid;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44px;
  text-align: center;
  box-sizing: border-box;
}

.privacy-btn::after {
  border: none;
}

.privacy-reject {
  margin-right: 20rpx;
  background: #fff;
  color: #1D4E9E;
  border-color: #1D4E9E;
}

.privacy-agree {
  background: #1D4E9E;
  color: #fff;
  border-color: #1D4E9E;
}
