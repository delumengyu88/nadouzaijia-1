<view hidden="{{showSplash}}" aria-hidden="{{showSplash}}">
<view class="tab-page member-page">
<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar"><view class="nav-title">{{title}}</view></view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="fail-card" wx:if="{{loadError}}">
  <view class="fail-copy">网络异常，请重试</view>
  <button class="retry-btn" bindtap="retryLoad">重试</button>
</view>
<view class="info-card" wx:if="{{!loading && !loadError && heading}}">
  <view class="info-name">{{heading}}</view>
  <view class="info-line" wx:if="{{detail}}">{{detail}}</view>
  <view class="info-line" wx:if="{{extraLine}}">{{extraLine}}</view>
</view>
<view class="member-status" wx:elif="{{loading}}">加载中</view>
<view class="member-status clip" wx:elif="{{guest}}">{{statusLine}}</view>
<block wx:if="{{!loading && !testBuild}}">
<view class="choice {{plan.selectable ? '' : 'static'}} {{plan.selectable && selected == plan.id ? 'on' : ''}}" wx:for="{{plans}}" wx:for-item="plan" wx:key="id" data-id="{{plan.id}}" bindtap="pick">
  <view class="choice-top">
    <text class="choice-name">{{plan.name}}<text class="current-tier" wx:if="{{plan.current}}">当前</text></text>
    <view class="price-row">
      <text class="price">{{plan.priceText}}</text>
      <view wx:if="{{plan.selectable}}" class="radio {{selected == plan.id ? 'on' : ''}}"></view>
    </view>
  </view>
  <view class="benefit {{perk.ok ? '' : 'no'}}" wx:for="{{plan.perks}}" wx:for-item="perk" wx:key="text">
    <text class="perk-mark {{perk.ok ? '' : 'gap'}}">✓</text>
    <text>{{perk.text}}</text>
  </view>
</view>
</block>
<view class="info-card" wx:if="{{showDiamondOffer}}">
  <view class="info-name">钻石会员</view>
  <view class="info-line">¥1.00 / 5 天 · 与 VIP 会员享有相同权益</view>
  <button class="btn" bindtap="openDiamond">开通钻石会员 ¥1.00</button>
</view>
<view class="info-card" wx:if="{{showTestOffer}}">
  <view class="info-name">支付测试 ¥1.00</view>
  <view class="info-line">普通会员 1 天</view>
  <button class="btn" bindtap="openTestOffer">确认开通 ¥1.00</button>
</view>
<view class="pay-slot" wx:if="{{!testBuild}}">
  <button class="btn pay-btn {{showPay ? '' : 'is-held'}}" bindtap="go" loading="{{loginLoading}}" disabled="{{loginLoading}}">{{payLabel}}</button>
</view>
<view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
<view class="invite-link" bindtap="openInvite">输入邀请码</view>
</view>
</view>
<include src="../../components/launch-poster/view.wxml" />
