<view class="tab-page member-page">
<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar"><view class="nav-title">{{title}}</view></view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="fail-card" wx:if="{{loadError}}">
  <view class="fail-copy">网络异常，请重试</view>
  <button class="retry-btn" bindtap="retryLoad">重试</button>
</view>
<view class="member-status" wx:elif="{{loading}}">加载中</view>
<view class="member-status clip" wx:else>{{statusLine}}</view>
<view class="member-status clip" wx:if="{{!loading && !loadError && extraLine}}">{{extraLine}}</view>
<block wx:if="{{!loading}}">
<view class="choice {{plan.selectable && selected == plan.id ? 'on' : ''}}" wx:for="{{plans}}" wx:for-item="plan" wx:key="id" data-id="{{plan.id}}" bindtap="pick">
  <view class="choice-top">
    <text class="choice-name">{{plan.name}}</text>
    <view class="price-row">
      <text class="corner" wx:if="{{plan.current}}">当前</text>
      <text class="price" wx:if="{{plan.selectable}}">{{plan.priceText}}</text>
      <view wx:if="{{plan.selectable}}" class="radio {{selected == plan.id ? 'on' : ''}}"></view>
    </view>
  </view>
  <view class="benefit {{perk.ok ? '' : 'no'}}" wx:for="{{plan.perks}}" wx:for-item="perk" wx:key="text">
    <text class="perk-mark {{perk.ok ? '' : 'gap'}}">✓</text>
    <text>{{perk.text}}</text>
  </view>
</view>
</block>
<view class="pay-slot">
  <button class="btn pay-btn {{showPay ? '' : 'is-held'}}" bindtap="go" loading="{{loginLoading}}" disabled="{{loginLoading}}">{{payLabel}}</button>
</view>
<view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
<view class="invite-link" bindtap="openInvite">输入邀请码</view>
</view>
