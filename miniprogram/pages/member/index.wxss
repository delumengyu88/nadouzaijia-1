/* 375×667 budget (px, safe area 0) lives in utils/member.js LAYOUT:
   status 12+22, card margin 8 + border 4 + padding 22 + header 24 + perks 66 = 124,
   pay margin 12 + 44, invite margin 10 + 22, padding-bottom 56. */
.member-page {
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: calc(56px + env(safe-area-inset-bottom));
}

.member-page .member-status {
  margin: 12px 16px 0;
  height: 22px;
  line-height: 22px;
  font-size: 15px;
  color: #1c2430;
}

.member-page .choice {
  margin: 8px 16px 0;
  padding: 10px 14px 12px;
  border: 2px solid transparent;
  border-radius: 12px;
  background: #fff;
}

.member-page .choice.on {
  border-color: #1D4E9E;
  background: #E7F0FF;
}

.member-page .choice-top {
  height: 24px;
  align-items: center;
}

.member-page .choice-name {
  font-size: 16px;
  line-height: 24px;
}

.member-page .price-row {
  flex-shrink: 0;
}

.member-page .benefit {
  display: flex;
  align-items: center;
  margin-top: 4px;
  height: 18px;
  font-size: 13px;
  line-height: 18px;
  color: #1c2430;
}

.member-page .perk-mark {
  color: #1b8a4a;
  margin-right: 4px;
  font-weight: 700;
}

.member-page .benefit.no {
  color: #8b95a3;
}

.member-page .pay-slot {
  height: 44px;
  margin: 12px 16px 0;
}

.member-page .pay-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  margin: 0;
  background: #1D4E9E;
  color: #fff;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  text-align: center;
}

.member-page .pay-btn.is-held {
  visibility: hidden;
}

.member-page .invite-link {
  margin-top: 10px;
  height: 22px;
  line-height: 22px;
  text-align: center;
  color: #1D4E9E;
  font-size: 14px;
  background: transparent;
}
