/* 375×667 budget (px, safe area 0) lives in utils/member.js LAYOUT.
   Three cards keep the 44px confirm slot. Extra height scrolls instead of shrinking it. */
.member-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(56px + env(safe-area-inset-bottom));
}

.member-page .info-card {
  margin: 12px 16px 12px;
  padding: 16px 14px;
  border-radius: 12px;
  background: #fff;
}

.member-page .info-name {
  font-size: 18px;
  font-weight: 700;
  line-height: 1.3;
}

.member-page .info-line {
  margin-top: 4px;
  color: #66707c;
  font-size: 12px;
  line-height: 18px;
}

.member-page .member-status {
  margin: 12px 16px 0;
  height: 22px;
  line-height: 22px;
  font-size: 15px;
  color: #1c2430;
}

.member-page .choice {
  margin: 8px 16px 0;
  padding: 10px 14px 12px;
  border: 2px solid transparent;
  border-radius: 12px;
  background: #fff;
}

.member-page .choice.on {
  border-color: #1D4E9E;
  background: #E7F0FF;
}

.member-page .choice.static {
  background: #e8ecf1;
  box-shadow: none;
}

.member-page .choice-top {
  height: 24px;
  align-items: center;
}

.member-page .choice-name {
  font-size: 16px;
  line-height: 24px;
}

.member-page .price-row {
  flex-shrink: 0;
}

.member-page .price {
  color: #1c2430;
  font-weight: 700;
}

.member-page .benefit {
  display: flex;
  align-items: center;
  margin-top: 4px;
  height: 18px;
  font-size: 13px;
  line-height: 18px;
  color: #1c2430;
}

.member-page .perk-mark {
  flex: 0 0 auto;
  margin-right: 4px;
  color: #1b8a4a;
  font-weight: 700;
}

.member-page .perk-mark.gap {
  visibility: hidden;
}

.member-page .benefit.no {
  color: #8b95a3;
}

.member-page .pay-slot {
  height: 44px;
  margin: 12px 16px 0;
  flex-shrink: 0;
}

.member-page .pay-btn {
  width: 100%;
  height: 44px;
  line-height: 44px;
  margin: 0;
  background: #1D4E9E;
  color: #fff;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  text-align: center;
}

.member-page .pay-btn.is-held {
  visibility: hidden;
}

.member-page .member-status.clip {
  overflow:hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-page .fail-card {
  margin: 12px 16px 0;
  padding: 14px;
  border-radius: 12px;
  background: #fff;
  text-align: center;
}

.member-page .fail-copy {
  color: #dc2626;
  font-size: 14px;
  line-height: 22px;
}

.member-page .retry-btn {
  margin-top: 8px;
  min-width: 88px;
  height: 32px;
  line-height: 32px;
  padding: 0 14px;
  border-radius: 8px;
  background: #1D4E9E;
  color: #fff;
  font-size: 14px;
}

.member-page .retry-btn::after { border: none; }

.member-page .corner {
  margin-right: 8px;
  color: #1D4E9E;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
}

.member-page .invite-link {
  margin-top: 10px;
  height: 22px;
  line-height: 22px;
  text-align: center;
  color: #1D4E9E;
  font-size: 14px;
  background: transparent;
}

.current-tier { margin-left: 12rpx; font-size: 24rpx; color: #1D4E9E; }
