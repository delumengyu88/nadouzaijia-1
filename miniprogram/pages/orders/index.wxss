.order-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.order-title {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  min-width: 0;
}

.order-test {
  flex: none;
  margin-left: 8rpx;
  padding: 0 8rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 6rpx;
  background: #eef0f3;
  color: #8b93a0;
  font-size: 20rpx;
  font-weight: 400;
}

.order-side {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.order-status {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
}

.order-status.granted { color: #1D4E9E; }
.order-status.pending { color: #e4570e; }
.order-status.error { color: #e24b4a; }
.order-status.refunded { color: #8b95a3; }

.order-service {
  width: auto;
  min-width: 0;
  margin: 0 0 0 8rpx;
  padding: 0;
  background: transparent;
  color: #1D4E9E;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
  white-space: nowrap;
}

.order-sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #d5dde8;
}

.order-sk-line.short {
  width: 46%;
  margin-top: 12rpx;
}
