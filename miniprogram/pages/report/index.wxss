@import "../../styles/hit-rows.wxss";
/* local */

.evidence-link { color: #1D4E9E; font-size: 26rpx; margin-left: 20rpx; padding: 20rpx 0; }
.tag.miss { background: #F2F3F5; color: #646A73; }
.nav-back { display: flex; align-items: center; justify-content: center; line-height: 1; padding: 0; }
.nav-title { top: 0; height: 88rpx; line-height: 88rpx; }
.thumb.thumb-plain { background: #d5dde8; }
.age-tag { margin-left: 12rpx; color: #1D4E9E; background: #e7f0ff; border-radius: 6rpx; padding: 0 8rpx; font-size: 20rpx; }
.example-empty { color: #9aa3af; font-size: 26rpx; line-height: 1.6; }

.card.summary-lock { padding: 0; overflow: hidden; }
.summary-veil { position: relative; overflow: hidden; background: #edf2f8; padding: 28rpx; text-align: center; }
.summary-mosaic { position: absolute; inset: 0; opacity: .4; background-color: #c4d2df; background-image: linear-gradient(45deg, #e8eef5 25%, transparent 25%, transparent 75%, #e8eef5 75%), linear-gradient(45deg, #e8eef5 25%, transparent 25%, transparent 75%, #e8eef5 75%); background-position: 0 0, 10rpx 10rpx; background-size: 20rpx 20rpx; }
.summary-padlock { position: relative; width: 28rpx; margin: 0 auto 12rpx; }
.summary-locked-title { position: relative; font-size: 30rpx; font-weight: 600; color: #244468; }
.summary-content { padding: 24rpx 28rpx; }
.summary-plan { border-top: 1px solid #edf0f4; margin-top: 20rpx; padding-top: 20rpx; }
.summary-content .btn { margin: 16rpx 0 0; }

/* 方案 B：按时间分档的时间轴 */
.tline { margin: 20rpx 32rpx 0 20rpx; }
.tl-band { display: flex; position: relative; }
.tl-axis { width: 44rpx; flex-shrink: 0; position: relative; }
.tl-axis::before { content: ""; position: absolute; left: 21rpx; top: 0; bottom: 0; width: 2rpx; background: #c9d3e3; }
.tl-band:first-child .tl-axis::before { top: 36rpx; }
.tl-band:last-child .tl-axis::before { bottom: auto; height: 36rpx; }
.tl-node { position: absolute; left: 10rpx; top: 26rpx; width: 24rpx; height: 24rpx; border-radius: 50%; background: #fff; border: 3rpx solid #9fb3d1; box-sizing: border-box; }
.tl-node.on { background: #1D4E9E; border-color: #1D4E9E; }
.tl-card { flex: 1; min-width: 0; background: #fff; border-radius: 20rpx; padding: 22rpx 24rpx; margin-bottom: 20rpx; border: 2rpx solid #e3e8ef; }
.tl-card.open { border-color: #1D4E9E; }
.tl-head { display: flex; align-items: center; justify-content: space-between; min-height: 56rpx; }
.tl-chevron { flex-shrink: 0; margin-left: 12rpx; color: #8b95a3; font-size: 28rpx; line-height: 1; }
.tl-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; color: #1c2430; }
.tl-lock { margin-right: 8rpx; font-size: 26rpx; }
.tl-state { flex-shrink: 0; margin-left: 16rpx; font-size: 24rpx; color: #1D4E9E; }
.tl-buy { flex-shrink: 0; margin-left: 16rpx; height: 56rpx; line-height: 52rpx; padding: 0 22rpx; border: 2rpx solid #1D4E9E; border-radius: 28rpx; color: #1D4E9E; font-size: 24rpx; font-weight: 600; background: #fff; }
.tl-hint { margin-top: 8rpx; font-size: 24rpx; color: #8b95a3; }
.tl-note { margin-top: 18rpx; text-align: center; font-size: 24rpx; color: #646a73; }
.tl-link { color: #1D4E9E; text-decoration: underline; }
.tl-foot { margin: 8rpx 0 0 44rpx; text-align: center; font-size: 26rpx; color: #8b95a3; }
.tl-zoom { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 60; background: rgba(12, 18, 28, .92); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tl-zoom-img { width: 100%; height: 70vh; }
.tl-zoom-close { margin-top: 24rpx; color: rgba(255,255,255,.75); font-size: 24rpx; }
