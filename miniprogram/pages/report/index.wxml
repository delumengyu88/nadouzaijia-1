<view hidden="{{showSplash}}" aria-hidden="{{showSplash}}">
<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="back">‹</view>
    <view class="nav-title">{{title}}</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body" wx:if="{{phase == 'loading'}}">
  <view class="center-box"><view class="center-title">正在加载</view></view>
</view>
<view class="body" wx:elif="{{phase == 'fail'}}">
  <view class="center-box">
    <view class="center-title">加载失败</view>
    <view class="sub">{{error}}</view>
    <view class="btn slim" bindtap="retry">重试</view>
  </view>
</view>
<view class="body" wx:elif="{{phase == 'unverified'}}">
  <view class="center-box"><view class="center-title">数据待核验</view></view>
</view>
<view class="body" wx:elif="{{phase == 'empty'}}">
  <view class="center-box">
    <view class="center-title">暂无记录</view>
  </view>
</view>
<view class="body" wx:else>
  <view class="warn-box" wx:if="{{expired}}">权益已到期</view>
  <view class="pad" style="margin-top:12rpx;">
    <view class="choice-top">
      <text class="h1" style="font-size:40rpx;">{{name}}</text>
      <view><text class="tag {{badgeCls}}">{{badge}}</text><text class="evidence-link" wx:if="{{showEvidenceLink}}" bindtap="applyEvidence">{{appliedId ? '已申请 ›' : '委托取证 ›'}}</text></view>
    </view>
    <view class="sub" wx:if="{{example && platformLine}}">{{platformLine}}</view>
    <view class="sub">{{header}}</view>
    <view class="choice-top" wx:if="{{showLocked}}" style="margin-top:16rpx;">
      <text>{{recordLine}}</text>
      <text>{{lockedRange}}</text>
    </view>
    <view class="ex-tag" wx:if="{{example}}" style="margin-top:12rpx;">示例</view>
  </view>
  <view class="note" wx:if="{{note}}">{{note}}</view>
  <view class="card" wx:if="{{exampleEmpty}}">
    <view class="example-empty">暂无可展示的示例记录</view>
  </view>
  <view class="tline" wx:if="{{useTimeline}}">
    <view class="tl-band" wx:for="{{timeline.bands}}" wx:for-item="band" wx:for-index="bi" wx:key="key">
      <view class="tl-axis"><view class="tl-node {{band.expanded ? 'on' : ''}}"></view></view>
      <view class="tl-card {{band.expanded ? 'open' : ''}} {{band.foldable ? 'foldable' : ''}}">
        <view class="tl-summary" data-index="{{bi}}" bindtap="toggleBand">
        <view class="tl-head">
          <view class="tl-title"><text wx:if="{{band.locked}}" class="tl-lock">🔒</text>{{band.title}}</view>
          <text class="tl-state" wx:if="{{band.open && !band.empty}}">{{band.status}}</text>
          <view class="tl-buy" wx:elif="{{band.locked && !band.empty && band.buyText}}" data-index="{{bi}}" catchtap="unlockBand">{{band.buyText}}</view>
          <view class="tl-buy" wx:elif="{{band.evidence && !band.empty}}" catchtap="evidence">去委托取证</view>
          <text class="tl-chevron" wx:if="{{band.foldable}}">{{band.expanded ? '∧' : '∨'}}</text>
        </view>
        <view class="tl-hint" wx:if="{{band.hint && !band.empty}}">{{band.hint}}</view>
        <view class="tl-hint" wx:if="{{band.empty}}">暂无记录</view>
        </view>
        <block wx:if="{{band.expanded && band.open && !band.empty}}">
          <view class="tl-rec" wx:for="{{band.rows}}" wx:for-item="row" wx:for-index="ri" wx:key="id">
            <view class="tl-rec-top" data-band="{{bi}}" data-row="{{ri}}" bindtap="toggleRow">
              <text class="tl-platform">{{row.platform}}<text class="tl-subtype" wx:if="{{row.sub}}"> {{row.sub}}</text></text>
              <text class="tl-meta" wx:if="{{row.expanded}}">{{row.network}}</text>
              <text class="tl-meta" wx:else>{{row.network}}{{row.network && row.frames ? ' · ' : ''}}{{row.frames}}{{row.date ? ' · ' + row.date : ''}}</text>
            </view>
            <block wx:if="{{row.expanded}}">
              <view class="tl-rec-sub"><text>{{row.frames}}</text><text>{{row.date}}</text></view>
              <view class="tl-shots">
                <view class="tl-shot {{row.blur ? 'blur' : ''}}" data-band="{{bi}}" data-row="{{ri}}" bindtap="openFrame">
                  <image wx:if="{{row.src}}" class="tl-img" src="{{row.src}}" mode="aspectFill" />
                  <view wx:else class="tl-ph"></view>
                  <text class="tl-wm" wx:if="{{!row.src}}">那豆在架</text>
                </view>
                <view class="tl-times">
                  <view class="tl-times-label">命中时间点</view>
                  <view class="tl-time" wx:for="{{row.times}}" wx:for-item="time" wx:key="*this">{{time}}</view>
                </view>
              </view>
            </block>
          </view>
          <view class="tl-note" wx:if="{{band.blur}}">模糊预览 · <text class="tl-link" bindtap="buyTimelineMember">开通会员看清晰图 ›</text></view>
          <view class="tl-note" wx:elif="{{band.clear}}">清晰截图 · 点击图片放大</view>
        </block>
      </view>
    </view>
    <view class="tl-foot" wx:if="{{timeline.memberCta}}">或 <text class="tl-link" bindtap="buyTimelineMember">{{timeline.memberCta}}</text> · 30天以上全部可看</view>
  </view>
  <view class="card" wx:if="{{showOpen}}" style="padding-top:8rpx;">
    <block wx:for="{{groups}}" wx:for-item="group" wx:key="platform">
      <block wx:for="{{group.rows}}" wx:for-item="row" wx:key="id">
        <view wx:if="{{row.summaryOnly}}" class="rec">
          <view class="rec-main">
            <view class="rec-title">命中摘要</view>
            <view wx:if="{{row.platform}}" class="rec-platform">{{row.platform}}</view>
            <view wx:if="{{row.network}}" class="rec-sub">{{row.network}}</view>
            <view wx:if="{{row.frames}}" class="rec-sub">{{row.frames}}</view>
            <view wx:if="{{row.date}}" class="rec-date">排查日期 {{row.date}}</view>
          </view>
        </view>
        <view class="rec" wx:else data-id="{{row.id}}" bindtap="openShot">
          <view class="thumb {{row.plainThumb ? 'thumb-plain' : ''}}">
            <image wx:if="{{row.image}}" src="{{row.image}}" data-id="{{row.id}}" data-src="{{row.image}}" binderror="imageFailed" mode="aspectFill" style="width:100%;height:100%;" />
            <block wx:elif="{{row.mock}}"><view class="moon"></view><view class="hill"></view></block>
            <block wx:if="{{!row.plainThumb}}">
              <text class="thumb-badge" wx:if="{{row.badge}}">{{row.badge}}</text>
              <text class="thumb-wm">那豆在架</text>
              <text class="thumb-time">{{row.time}}</text>
            </block>
          </view>
          <view class="rec-main">
            <view class="rec-title">{{row.title}}</view>
            <view class="rec-platform {{row.unknown ? 'unknown' : ''}}">
              {{row.platform}}
              <text class="qmark" wx:if="{{row.unknown}}" catchtap="ask">?</text>
            </view>
            <view class="rec-sub" wx:if="{{row.sub}}">{{row.sub}}</view>
            <view class="ex-sub" wx:if="{{row.category}}">{{row.category}}</view>
            <view class="rec-date" wx:if="{{row.date || row.ageLabel}}"><text wx:if="{{row.date}}">{{row.date}}</text><text class="age-tag" wx:if="{{row.ageLabel}}">{{row.ageLabel}}</text></view>
          </view>
        </view>
      </block>
    </block>
  </view>
  <view class="card summary-lock" wx:if="{{summaryHidden}}">
    <view class="summary-veil">
      <view aria-hidden="true" class="summary-mosaic"></view>
      <view aria-hidden="true" class="summary-padlock"><view class="lock-shackle"></view><view class="lock-body"></view></view>
      <view class="summary-locked-title">{{summaryHidden}} 条命中摘要待解锁</view>
    </view>
    <view class="summary-content">
      <view class="rec-sub">解锁后可查看排查日期、平台、网络类型和命中帧数。</view>
      <view class="summary-plan" wx:for="{{summaryPlans}}" wx:key="id">
        <view class="row-title">{{item.title}}</view>
        <view class="rec-sub">{{item.price ? item.price + ' · ' : ''}}适用 {{item.count}} 条摘要</view>
        <button wx:if="{{item.purchasable}}" class="btn card-wide" data-id="{{item.id}}" bindtap="buySummary">选择此方案</button>
      </view>
      <view wx:if="{{summaryPlanError}}" class="rec-sub">解锁方案暂时无法加载。<text class="evidence-link" bindtap="retry">重试</text></view>
      <block wx:if="{{summaryHelp}}">
        <view class="rec-sub">暂未开放在线购买的方案可咨询客服。</view>
        <button class="btn plain card-wide" open-type="contact" bindtap="markNativeTap" session-from="report-summary">联系客服</button>
      </block>
    </view>
  </view>
  <view class="lock-box" wx:if="{{showLocked}}">
    <view class="fake-rows">
      <view class="fake-row" wx:for="{{fakeRows}}" wx:key="id">
        <view class="fake-thumb"></view>
        <view class="fake-lines">
          <view class="fake-line long"></view>
          <view class="fake-line mid"></view>
          <view class="fake-line short"></view>
        </view>
      </view>
    </view>
    <view class="lock-mask">
      <view class="lock-icon"><view><view class="lock-shackle"></view><view class="lock-body"></view></view></view>
      <view class="lock-text">{{unlockText}}</view>
      <view class="btn slim" wx:if="{{showMemberOffer}}" style="width:360rpx;" bindtap="buyMember">{{memberText}}</view>
    </view>
  </view>
  <view class="note" wx:if="{{showHint}}">在线查看 7 天</view>
  <view class="btn block plain" wx:if="{{showLocked && showSingleOffer}}" bindtap="buySingle">{{singleText}}</view>
  <view class="card" wx:if="{{showEvidence}}">
    <view class="row-title">有最新记录，可委托取证</view>
    <view class="btn" bindtap="evidence">委托取证</view>
  </view>
  <button class="btn block plain page-wide" wx:if="{{showDownload}}" bindtap="download" loading="{{downloadLoading}}" disabled="{{downloadLoading}}">下载报告</button>
  <button class="btn block plain page-wide" wx:for="{{reportParts}}" wx:key="*this" data-name="{{item}}" bindtap="openPart">打开 {{item}}</button>
  <view class="foot-gap"></view>
</view>
<view class="tl-zoom" wx:if="{{zoomSrc}}" bindtap="closeZoom">
  <image class="tl-zoom-img" src="{{zoomSrc}}" mode="aspectFit" />
  <view class="tl-zoom-close">点击任意处关闭</view>
</view>
</view>
<include src="../../components/launch-poster/view.wxml" />
