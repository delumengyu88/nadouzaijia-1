<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="back">‹</view>
    <view class="nav-title">申请取证</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body" wx:if="{{phase == 'form'}}">
  <view class="note">取证由客服线下交付，提交后客服会在 1 个工作日内联系您。</view>
  <view class="field-label">类型</view>
  <view class="field">{{kindText}}</view>
  <view class="field-label">节目名</view>
  <input class="field" value="{{name}}" bindinput="onName" />
  <view class="field-label">补充说明（可选）</view>
  <textarea class="field" style="min-height:140rpx;" value="{{note}}" bindinput="onNote" />
  <view class="field-label">联系方式</view>
  <view class="field">{{phoneShown}}</view>
  <view class="btn block" bindtap="submit">提交申请</view>
</view>
<view class="body" wx:elif="{{phase == 'submitted'}}">
  <view class="center-box">
    <view class="tag ok">已提交</view>
    <view class="center-sub">申请编号 {{no}}。客服受理后会与你联系，交付为线下。</view>
    <view class="btn slim" bindtap="open">查看申请</view>
  </view>
</view>
<view class="body" wx:else>
  <view class="center-box">
    <view class="tag warn">已有申请在处理中</view>
    <view class="center-sub">同一记录 24 小时内不可重复提交。可查看已有申请或联系客服。</view>
    <view class="btn slim" bindtap="open">查看申请</view>
  </view>
</view>
