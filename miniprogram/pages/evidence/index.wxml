<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="back">‹</view>
    <view class="nav-title">委托取证</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body" wx:if="{{phase == 'form'}}">
  <view class="note">客服线下交付，1 个工作日内联系您。</view>
  <view class="field-label">类型</view>
  <view class="field">{{kindText}}</view>
  <view class="field-label">节目名</view>
  <input class="field" value="{{name}}" bindinput="onName" />
  <view class="field-error" wx:if="{{nameError}}">{{nameError}}</view>
  <block wx:if="{{kind != 'recent'}}">
    <view class="field-label">平台（选填）</view>
    <input class="field" value="{{platform}}" bindinput="onPlatform" />
  </block>
  <view class="field-label">补充说明（可选）</view>
  <textarea class="field" style="min-height:140rpx;" value="{{note}}" bindinput="onNote" maxlength="50" />
  <view class="field-label">手机号<text class="req">*</text></view>
  <input class="field {{phoneError ? 'field-bad' : ''}}" type="number" maxlength="11" value="{{phone}}" focus="{{phoneFocus}}" bindinput="onPhone" />
  <view class="field-error" wx:if="{{phoneError}}">{{phoneError}}</view>
  <view class="field-error" wx:if="{{networkError}}">网络异常，请重试</view>
  <button class="btn block" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">{{networkError ? '重试' : '提交申请'}}</button>
</view>
<view class="body" wx:elif="{{phase == 'submitted'}}">
  <view class="center-box">
    <view class="tag ok">已提交</view>
    <view class="center-sub">申请编号 {{no}}</view>
    <button class="btn slim" bindtap="open">查看工单</button>
  </view>
</view>
<view class="mask" wx:if="{{showDuplicate}}">
  <view class="dialog">
    <view class="dialog-title">这个节目已经提交过取证申请</view>
    <button class="btn" bindtap="openExisting">查看已有工单</button>
  </view>
</view>
