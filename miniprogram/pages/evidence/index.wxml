<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="back">‹</view>
    <view class="nav-title">委托取证</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body" wx:if="{{phase == 'form'}}">
  <view class="note">客服线下交付，会尽快联系您。</view>
  <view class="field-label">类型</view>
  <view class="field type-field"><text>{{kindText}}</text><text class="chev">›</text></view>
  <view class="field-label">节目名</view>
  <input class="field" value="{{name}}" placeholder="请输入节目名" bindinput="onName" />
  <view class="field-error" wx:if="{{nameError}}">{{nameError}}</view>
  <block wx:if="{{kind != 'recent'}}">
    <view class="field-label">平台（选填）</view>
    <input class="field" value="{{platform}}" placeholder="" bindinput="onPlatform" />
  </block>
  <view class="field-label">补充说明（选填）</view>
  <textarea class="field" style="min-height:140rpx;" value="{{note}}" placeholder="50 字以内" bindinput="onNote" maxlength="50" />
  <view class="field-label">手机号<text class="req">*</text></view>
  <input class="field {{phoneError ? 'field-bad' : ''}}" type="number" maxlength="11" value="{{phone}}" placeholder="11 位手机号" focus="{{phoneFocus}}" bindinput="onPhone" />
  <view class="field-error" wx:if="{{phoneError}}">{{phoneError}}</view>
  <view class="field-error" wx:if="{{networkError}}">网络异常，请重试</view>
  <button class="btn block" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">{{networkError ? '重试' : '提交申请'}}</button>
</view>
<view class="body" wx:elif="{{phase == 'submitted'}}">
  <view class="done">
    <icon type="success" size="56" color="#16A34A" />
    <view class="done-title">已提交</view>
    <view class="done-sub">
      <view wx:if="{{no}}">申请编号 {{no}}</view>
      <view>客服会尽快联系您</view>
    </view>
    <button class="done-primary" bindtap="open">查看工单</button>
    <button class="done-link" bindtap="back">返回</button>
  </view>
</view>
<view class="mask" wx:if="{{showDuplicate}}">
  <view class="dialog">
    <view class="dialog-title">这个节目已经提交过取证申请</view>
    <view class="dup-actions">
      <button class="dup-btn dup-ghost" bindtap="closeDuplicate">知道了</button>
      <button class="dup-btn dup-primary" bindtap="openExisting">查看已有工单</button>
    </view>
  </view>
</view>
