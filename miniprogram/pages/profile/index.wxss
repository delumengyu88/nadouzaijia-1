.profile-page .card {
  margin: 12px 16px 12px;
  padding-top: 16px;
  padding-bottom: 16px;
}
.profile-page .guest-identity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: nowrap;
  width: calc(100% - 32px);
  min-height: 56px;
  box-sizing: border-box;
  padding-top: 4px;
  padding-bottom: 4px;
}
.guest-identity-label {
  flex: 1 1 auto;
  white-space: nowrap;
}
.guest-identity-card button.profile-retry {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  width: auto;
  max-width: none;
  min-width: max(44px, 88rpx);
  min-height: max(44px, 88rpx);
  margin: 0 0 0 auto;
  padding: 4rpx 0 4rpx 16rpx;
  white-space: nowrap;
  line-height: 1.4;
}
.profile-page .row {
  padding: 24rpx 32rpx;
}
.profile-page button.contact-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  margin: 0;
  height: auto;
  line-height: inherit;
  text-align: left;
  border-radius: 0;
  background: #fff;
}
.profile-page button.contact-row::after { border: 0; }
.invite-row { min-height: 102rpx; box-sizing: border-box; }
.invite-bound { margin-left: 16rpx; color: #646A73; font-size: 28rpx; line-height: 40rpx; }
.card .choice-top { min-width: 0; }
.nick {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}
.card .tag { flex: none; }
.load-fail { text-align: center; }
.fail-copy { color: #dc2626; font-size: 28rpx; line-height: 1.5; }
.retry-btn {
  margin-top: 16rpx;
  min-width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  background: #1D4E9E;
  color: #fff;
  font-size: 28rpx;
}
.retry-btn::after { border: none; }
