.profile-page .card {
  margin: 12px 16px 12px;
  padding-top: 16px;
  padding-bottom: 16px;
}
.row { padding-top: 24rpx; padding-bottom: 24rpx; }
.card .choice-top { min-width: 0; }
.nick {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}
.card .tag { flex: none; }
.load-fail { text-align: center; }
.fail-copy { color: #dc2626; font-size: 28rpx; line-height: 1.5; }
.retry-btn {
  margin-top: 16rpx;
  min-width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  background: #1D4E9E;
  color: #fff;
  font-size: 28rpx;
}
.retry-btn::after { border: none; }
