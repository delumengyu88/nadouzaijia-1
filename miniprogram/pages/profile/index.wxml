<view class="tab-page profile-page">
<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar"><view class="nav-title">我的</view></view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body">
  <view class="card choice-top" wx:if="{{guest}}">
    <text class="row-title">未登录</text>
    <view><button class="login-link" bindtap="login" loading="{{loginLoading}}" disabled="{{loginLoading}}">微信登录</button><view class="login-error" wx:if="{{loginError}}">{{loginError}}</view></view>
  </view>
  <view class="card" wx:else>
    <view class="choice-top">
      <text class="h1" style="font-size:36rpx;">{{title}}</text>
      <text class="tag vip" wx:if="{{badge}}">{{badge}}</text>
    </view>
    <view class="ex-line" wx:for="{{lines}}" wx:key="*this">{{item}}</view>
  </view>
  <block wx:if="{{!guest}}">
    <view class="row" data-url="/pages/evidence-list/index" bindtap="go">
      <view class="row-main"><view class="row-title">取证申请</view></view>
      <text class="chev">›</text>
    </view>
    <view class="row" data-url="/pages/records/index" bindtap="go">
      <view class="row-main"><view class="row-title">查询记录</view></view>
      <text class="chev">›</text>
    </view>
    <view class="row invite-row" wx:if="{{!inviteLoading && bound && !inviteError}}">
      <view class="row-main"><view class="row-title">邀请码</view></view>
      <text class="invite-bound">已绑定 {{inviteMask}}</text>
    </view>
    <view class="row invite-row" wx:elif="{{!inviteLoading}}" data-url="/pages/invite/index" bindtap="go">
      <view class="row-main"><view class="row-title">{{inviteError || bindText}}</view></view>
      <text class="chev" wx:if="{{!inviteError}}">›</text>
    </view>
    <view class="row" data-url="/pages/orders/index" bindtap="go">
      <view class="row-main"><view class="row-title">我的订单</view></view>
      <text class="chev">›</text>
    </view>
  </block>
  <view class="row" data-url="/pages/legal/index" bindtap="go">
    <view class="row-main"><view class="row-title">协议与隐私</view></view>
    <text class="chev">›</text>
  </view>
  <button class="row" open-type="contact" session-from="profile">
    <view class="row-main"><view class="row-title">联系客服</view></view>
    <text class="chev">›</text>
  </button>
  <view class="row" wx:if="{{useMock}}" bindtap="openSheet">
    <view class="row-main"><view class="row-title">切换账号</view></view>
    <text class="chev">›</text>
  </view>
</view>
</view>
<view class="mask" wx:if="{{showSheet}}" bindtap="closeSheet">
  <view class="sheet" catchtap="noop">
    <view class="sheet-item" data-id="guest" bindtap="useAccount">未登录</view>
    <view class="sheet-item" data-id="free" bindtap="useAccount">免费用户</view>
    <view class="sheet-item" data-id="member" bindtap="useAccount">会员</view>
    <view class="sheet-item" bindtap="closeSheet">取消</view>
  </view>
</view>
