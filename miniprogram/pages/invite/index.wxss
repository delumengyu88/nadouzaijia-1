.code-box {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  min-height: 88rpx;
}
.code-box.bad { border-color: #d64545; }
.code-side { width: 88rpx; height: 88rpx; flex: none; }
.code-input {
  flex: 1;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  letter-spacing: 8rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
}
.code-clear {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 40rpx;
  color: #8b95a3;
  flex: none;
}
button.btn.off[disabled] {
  background: #e6e9ee !important;
  color: #a0a8b3 !important;
  opacity: 1;
}
.success-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 128rpx;
  text-align: center;
}
.success-mark {
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid #16A34A;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.success-tick {
  width: 32rpx;
  height: 18rpx;
  margin-top: -6rpx;
  border-left: 4rpx solid #16A34A;
  border-bottom: 4rpx solid #16A34A;
  transform: rotate(-45deg);
}
.success-title {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2329;
  line-height: 1.4;
}
.success-sub {
  margin-top: 16rpx;
  padding: 0 64rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #646A73;
  line-height: 40rpx;
  text-align: center;
  overflow: hidden;
  max-height: 80rpx;
}
.success-primary {
  width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 48rpx 0 0;
  padding: 0;
  background: #1D4E9E;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}
.success-primary::after { border: none; }
.success-link {
  margin-top: 24rpx;
  padding: 0;
  background: transparent;
  color: #1D4E9E;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
}
.success-link::after { border: none; }
