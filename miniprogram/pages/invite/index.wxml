<view hidden="{{showSplash}}" aria-hidden="{{showSplash}}">
<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="back">‹</view>
    <view class="nav-title">兑换邀请码</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body" wx:if="{{phase == 'success'}}">
  <view class="success-wrap">
    <view class="success-mark"><view class="success-tick"></view></view>
    <view class="success-title">兑换成功</view>
    <view class="success-sub">
      <view>已发放普通会员 30 天</view>
      <view wx:if="{{sub}}">{{sub}}</view>
    </view>
    <button class="success-primary" bindtap="profile">查看个人中心</button>
    <button class="success-link" bindtap="home">返回首页</button>
  </view>
</view>
<view class="body" wx:elif="{{phase == 'loading'}}">
  <view class="center-box"><view class="center-title">正在加载</view></view>
</view>
<view class="body" wx:elif="{{phase == 'guest'}}">
  <button class="btn block" bindtap="login" loading="{{loginLoading}}" disabled="{{loginLoading}}">重试</button>
  <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
</view>
<view class="body" wx:elif="{{phase == 'unavailable'}}">
  <view class="center-box">
    <view class="center-title">{{message}}</view>
    <button class="btn" bindtap="retryLoad">重试</button>
  </view>
</view>
<view class="body" wx:else>
  <view class="note">8 位字母或数字</view>
  <view class="code-box {{fieldError ? 'bad' : ''}}">
    <view class="code-side"></view>
    <input class="code-input" value="{{code}}" bindinput="onCode" disabled="{{phase == 'bound' || phase == 'rate' || phase == 'redeeming'}}" maxlength="8" />
    <view class="code-clear" wx:if="{{code && phase != 'bound' && phase != 'rate' && phase != 'redeeming'}}" catchtap="clearCode">×</view>
    <view class="code-side" wx:else></view>
  </view>
  <view class="note" wx:if="{{phase == 'redeeming'}}" style="color:#1D4E9E;text-align:center;">正在兑换…</view>
  <view class="err-box" wx:if="{{phase == 'error' || phase == 'bound' || phase == 'rate'}}">{{message}}</view>
  <button class="btn block {{(phase == 'bound' || phase == 'rate' || code.length < 8) && phase != 'redeeming' ? 'off' : ''}}" bindtap="submit" loading="{{phase == 'redeeming'}}" disabled="{{phase == 'redeeming' || phase == 'bound' || phase == 'rate' || code.length < 8}}">兑换</button>
</view>
</view>
<include src="../../components/launch-poster/view.wxml" />
