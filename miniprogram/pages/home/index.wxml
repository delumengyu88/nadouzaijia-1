<view hidden="{{showSplash}}" aria-hidden="{{showSplash}}">
<view class="tab-page">
<view class="nav" wx:if="{{!showSplash}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-brand">那豆在架</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body">
  <view class="banner run" wx:if="{{banner == 'running'}}" bindtap="openRunning">
    <text>{{bannerText}}</text><text class="chev">›</text>
  </view>
  <view class="banner guest-banner" wx:elif="{{banner == 'guest'}}">
    <text class="guest-identity">免费用户</text>
    <button wx:if="{{loginError || !identifying}}" class="login-link guest-retry" bindtap="login" loading="{{loginLoading}}" disabled="{{loginLoading}}">重试</button>
  </view>
  <view class="banner" wx:elif="{{banner == 'free'}}">{{bannerText}}</view>
  <view class="card">
    <view class="card-title">输入片单</view>
    <textarea class="area" placeholder="粘贴或输入节目名，一行一个" value="{{draft}}" bindinput="onInput" maxlength="20000" />
    <view class="btn ghost" bindtap="upload">上传 Excel</view>
    <view class="hint">.xlsx，含「节目名称」列，≤500 行</view>
    <view class="btn" bindtap="start">开始查询</view>
  </view>
  <view class="guide">
    <text class="guide-tag">全网检索</text>
    <text class="guide-tag">分档查看</text>
    <text class="guide-tag">会员多看</text>
    <text class="guide-tag">下载报告</text>
  </view>
  <view class="recent" wx:if="{{recent}}">
    <view class="recent-head">
      <text class="recent-title">最近查询 · {{recent.name}} · 已可看 {{recent.count}} 条</text>
      <text class="recent-all" bindtap="openRecent">查看全部 ›</text>
    </view>
    <view class="recent-card">
      <view class="tl-rec" wx:for="{{recent.rows}}" wx:for-item="row" wx:for-index="ri" wx:key="id">
        <view class="tl-rec-top" data-row="{{ri}}" bindtap="toggleRecentRow">
          <text class="tl-platform">{{row.platform}}<text class="tl-subtype" wx:if="{{row.sub}}"> {{row.sub}}</text></text>
          <text class="tl-meta" wx:if="{{row.expanded}}">{{row.network}}</text>
          <text class="tl-meta" wx:else>{{row.network}}{{row.network && row.frames ? ' · ' : ''}}{{row.frames}}{{row.date ? ' · ' + row.date : ''}}</text>
        </view>
        <block wx:if="{{row.expanded}}">
          <view class="tl-rec-sub"><text>{{row.frames}}</text><text>{{row.date}}</text></view>
          <view class="tl-shots">
            <view class="tl-shot {{row.blur ? 'blur' : ''}}" data-row="{{ri}}" bindtap="openRecentFrame">
              <image wx:if="{{row.src}}" class="tl-img" src="{{row.src}}" mode="aspectFill" />
              <view wx:else class="tl-ph"></view>
              <text class="tl-wm" wx:if="{{!row.src}}">那豆在架</text>
            </view>
            <view class="tl-times">
              <view class="tl-times-label">命中时间点</view>
              <view class="tl-time" wx:for="{{row.times}}" wx:for-item="time" wx:key="*this">{{time}}</view>
            </view>
          </view>
        </block>
      </view>
      <view class="tl-note" wx:if="{{recent.blur}}">模糊预览 · <text class="tl-link" bindtap="buyRecentMember">开通会员看清晰图 ›</text></view>
      <view class="tl-note" wx:elif="{{recent.framesReady}}">清晰截图 · 点击图片放大</view>
    </view>
  </view>
  <block wx:if="{{examples.length || examplesError}}">
  <view class="sec-head">
    <text class="sec-title" bindtap="tapExamples">示例报告</text>
  </view>
  <view class="note" wx:if="{{examplesError}}" bindtap="loadHome">示例报告暂时无法加载，点击重试。</view>
  <view class="ex" wx:for="{{examples}}" wx:key="name" data-name="{{item.name}}" bindtap="openExample">
    <view class="thumb {{item.image || item.illustrated ? '' : 'thumb-plain'}}">
      <image wx:if="{{item.image}}" src="{{item.image}}" data-name="{{item.name}}" data-src="{{item.image}}" binderror="exampleImageFailed" mode="aspectFill" style="width:100%;height:100%;" />
      <block wx:elif="{{item.illustrated}}"><view class="moon"></view><view class="hill"></view></block>
    </view>
    <view class="ex-main">
      <view class="ex-name-row"><text class="ex-tag">示例</text><text class="ex-name">{{item.name}}</text></view>
      <view class="ex-line">{{item.line}}</view>
      <view class="ex-sub">{{item.sub}}</view>
    </view>
    <text class="chev">›</text>
  </view>
  </block>
  <view class="foot-gap"></view>
</view>
</view>
<view class="mask" wx:if="{{announcement && showAnnounce && !showSplash && !showPrivacy}}">
  <view class="dialog">
    <view class="dialog-title">{{announcement.title}}</view>
    <view class="dialog-body">{{announcement.body}}</view>
    <view class="btn" bindtap="closeAnnounce">{{announcement.buttonText}}</view>
    <view class="announce-dismiss" bindtap="closeAnnounce">知道了</view>
  </view>
</view>
<view class="mask" wx:if="{{showDone && !showAnnounce && !showSplash && !announcement}}">
  <view class="dialog">
    <view class="dialog-title">查询完成</view>
    <block wx:if="{{doneSingle}}">
      <view class="dialog-body">{{doneName}}</view>
      <view class="sub">{{doneLine}}</view>
    </block>
    <view class="dialog-body" wx:else>{{doneText}}</view>
    <view class="btn" bindtap="openDone">去查看</view>
  </view>
</view>
</view>
<view class="tl-zoom" wx:if="{{zoomSrc}}" bindtap="closeRecentZoom">
  <image class="tl-zoom-img" src="{{zoomSrc}}" mode="aspectFit" />
  <view class="tl-zoom-close">点击任意处关闭</view>
</view>
<include src="../../components/launch-poster/view.wxml" />
<privacy-popup />
