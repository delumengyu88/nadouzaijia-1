/* local */
.thumb.thumb-plain { background: #d5dde8; }
.announce-dismiss { margin-top: 20rpx; text-align: center; color: #8b95a3; font-size: 28rpx; line-height: 1.6; }

.guest-banner {
  width: calc(100% - 64rpx);
  box-sizing: border-box;
  flex-wrap: nowrap;
  padding-top: 0;
  padding-bottom: 0;
  min-height: 88rpx;
}
.guest-identity {
  flex: 1 1 auto;
  white-space: nowrap;
}
.guest-banner button.guest-retry {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  width: auto;
  max-width: none;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0 0 0 auto;
  padding: 4rpx 0 4rpx 16rpx;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.4;
}
