@import "../../styles/hit-rows.wxss";
/* local */
.thumb.thumb-plain { background: #d5dde8; }
.announce-dismiss { margin-top: 20rpx; text-align: center; color: #8b95a3; font-size: 28rpx; line-height: 1.6; }

.guest-banner {
  width: calc(100% - 64rpx);
  box-sizing: border-box;
  flex-wrap: nowrap;
  padding-top: 0;
  padding-bottom: 0;
  min-height: 88rpx;
}
.guest-identity {
  flex: 1 1 auto;
  white-space: nowrap;
}
.guest-banner button.guest-retry {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  width: auto;
  max-width: none;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0 0 0 auto;
  padding: 4rpx 0 4rpx 16rpx;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.4;
}


/* 首页说明：四个四字标签同一行，320 与 375 宽都不折行。 */
.guide {
  display: flex;
  flex-wrap: nowrap;
  align-items: stretch;
  justify-content: space-between;
  margin: 20rpx 32rpx 0;
  padding: 16rpx 12rpx;
  background: #fff;
  border-radius: 24rpx;
}
.guide-tag {
  flex: 1 1 0;
  min-width: 0;
  margin: 0 6rpx;
  padding: 10rpx 0;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #1D4E9E;
  background: #e7f0ff;
  border-radius: 10rpx;
  white-space: nowrap;
}

.recent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 32rpx 12rpx;
}
.recent-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1c2430;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-all {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #1D4E9E;
}
.recent-card {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 24rpx 22rpx;
  border: 2rpx solid #1D4E9E;
}
.recent-card .tl-rec:first-child { border-top: 0; margin-top: 0; }
.tl-note { margin-top: 18rpx; text-align: center; font-size: 24rpx; color: #646a73; }
.tl-link { color: #1D4E9E; text-decoration: underline; }
.tl-zoom { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 60; background: rgba(12, 18, 28, .92); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tl-zoom-img { width: 100%; height: 70vh; }
.tl-zoom-close { margin-top: 24rpx; color: rgba(255,255,255,.75); font-size: 24rpx; }
