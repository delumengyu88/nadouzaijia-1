<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="back">‹</view>
    <view class="nav-title">查询记录</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body">
  <view class="mask" wx:if="{{needLogin}}">
    <view class="dialog">
      <view class="dialog-title">登录后继续</view>
      <button class="btn" bindtap="login" loading="{{loginLoading}}" disabled="{{loginLoading}}">微信登录</button>
      <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
    </view>
  </view>
  <view class="result" wx:if="{{failed}}">
    <icon type="info" size="56" color="#8F959E" />
    <view class="result-title">{{failureText || '网络异常，请重试'}}</view>
    <view class="result-primary" bindtap="retryLoad">重试</view>
  </view>
  <view class="result" wx:elif="{{empty}}">
    <view class="list-ico">
      <view class="list-line"></view>
      <view class="list-line"></view>
      <view class="list-line short"></view>
    </view>
    <view class="result-title">还没有查询记录</view>
    <view class="result-primary" bindtap="goQuery">去查询</view>
  </view>
  <view class="row" wx:for="{{rows}}" wx:key="key" data-id="{{item.id}}" bindtap="open">
    <view class="row-main">
      <view class="row-title record-name">{{item.name}}</view>
      <view class="row-sub" wx:if="{{item.line}}">{{item.line}}</view>
    </view>
    <text class="tag {{item.badgeCls}}">{{item.badge}}</text>
    <text class="chev">›</text>
  </view>
</view>
