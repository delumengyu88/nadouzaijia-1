.record-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.result { padding-top: 128rpx; text-align: center; }
.result-title {
  margin-top: 32rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2329;
  line-height: 56rpx;
}
.result-primary {
  margin: 48rpx auto 0;
  width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1D4E9E;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.list-ico {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  box-sizing: border-box;
  border: 4rpx solid #C9CDD4;
  border-radius: 16rpx;
  background: #F7F8FA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.list-line {
  width: 48rpx;
  height: 6rpx;
  margin-top: 8rpx;
  border-radius: 4rpx;
  background: #8F959E;
}
.list-line.short { width: 32rpx; }
