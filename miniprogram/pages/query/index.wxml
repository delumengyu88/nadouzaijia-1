<view class="query-root" hidden="{{showSplash}}" aria-hidden="{{showSplash}}">
<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="back">‹</view>
    <view class="nav-title">{{title}}</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body" wx:if="{{calibrating}}">
  <view class="center-box">
    <view class="center-title">数据校准中</view>
    <view class="center-sub">校准完成后可查看结果</view>
    <view class="btn block" bindtap="home">返回首页</view>
  </view>
</view>
<view class="body" wx:elif="{{missing}}">
  <view class="result">
    <icon type="info" size="56" color="#8F959E" />
    <view class="result-title">记录不存在</view>
    <view class="result-primary" bindtap="back">返回</view>
  </view>
</view>
<view class="body" wx:elif="{{loadError}}">
  <view class="result">
    <icon type="info" size="56" color="#8F959E" />
    <view class="result-title">{{failureText || '网络异常，请重试'}}</view>
    <view class="result-primary" bindtap="retryLoad">重试</view>
  </view>
</view>
<view class="body" wx:elif="{{needLogin}}">
  <view class="mask">
    <view class="dialog">
      <view class="dialog-title">暂时无法读取查询记录</view>
      <button class="btn" bindtap="login" loading="{{loginLoading}}" disabled="{{loginLoading}}">重试</button>
      <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
    </view>
  </view>
</view>
<view class="body" wx:elif="{{loading}}"></view>
<view class="body" wx:elif="{{queued}}">
  <view class="center-box">
    <view class="center-title">排队中</view>
    <view class="center-sub">{{head}}</view>
  </view>
</view>
<view class="body" wx:elif="{{running || networkError}}">
  <view class="q-ring-block">
    <view class="q-ring {{ringSpin ? 'is-spin' : ''}} {{ringFull ? 'is-full' : ''}}">
      <view class="q-ring-track"></view>
      <view class="q-ring-progress">
        <view class="q-ring-clip right">
          <view class="q-ring-half right" style="transform: rotate({{ringRight}}deg);"></view>
        </view>
        <view class="q-ring-clip left">
          <view class="q-ring-half left" style="transform: rotate({{ringLeft}}deg);"></view>
        </view>
      </view>
      <view class="q-ring-spinner" wx:if="{{ringSpin}}">
        <view class="q-ring-arc"></view>
      </view>
      <view class="q-ring-hole">
        <view class="q-ring-ratio">{{ringText}}</view>
      </view>
    </view>
    <view class="q-ring-label">已完成 {{ringDone}} / 共 {{ringTotal}}</view>
    <view class="q-ring-wait" wx:if="{{running}}">{{ringWait}}</view>
  </view>
  <view class="err-box" wx:if="{{networkError && failBanner}}">{{failBanner}}</view>
  <view class="btn block" wx:if="{{showNetworkRetry}}" bindtap="retry">重试</view>
</view>
<view class="body" wx:else>
  <view class="err-box" wx:if="{{showFailBanner && failBanner}}">{{failBanner}}</view>
  <view class="note" wx:if="{{!showFailBanner && head}}">{{head}}</view>
  <view class="card" wx:for="{{rows}}" wx:key="name" data-name="{{item.name}}" data-hit="{{item.hit}}" bindtap="openHit">
    <view class="choice-top">
      <text class="row-title">{{item.name}}</text>
      <text class="tag {{item.badgeCls}}">{{item.badge}}</text>
    </view>
    <view class="ex-line" wx:if="{{item.line}}">{{item.line}}</view>
    <view class="btn report-btn" wx:if="{{item.hit}}" data-name="{{item.name}}" data-hit="{{item.hit}}" catchtap="openHit">查看报告</view>
    <view wx:if="{{item.hit}}" class="evidence-link" data-name="{{item.name}}" data-platform="{{item.evidencePlatform}}" data-evidence-name="{{item.evidenceName}}" catchtap="evidence">委托取证 ›</view>
    <view class="choice-top miss-actions" wx:if="{{item.missed}}">
      <view class="btn ghost miss-action" data-name="{{item.name}}" bindtap="requery">修改后重查</view>
      <view class="btn ghost miss-action" data-name="{{item.name}}" data-platform="{{item.evidencePlatform}}" data-evidence-name="{{item.evidenceName}}" bindtap="evidence">委托取证</view>
    </view>
    <view class="btn ghost item-retry" wx:if="{{item.failed && itemRetry}}" data-name="{{item.name}}" bindtap="retry">重试</view>
  </view>
  <view class="btn block" wx:if="{{showRetryAll}}" bindtap="retryAll">全部重试</view>
</view>
</view>
<include src="../../components/launch-poster/view.wxml" />
