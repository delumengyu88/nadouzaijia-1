<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-back" bindtap="back">‹</view>
    <view class="nav-title">查询结果</view>
  </view>
</view>
<view style="height: {{navHeight}}px;"></view>
<view class="body" wx:if="{{queued}}">
  <view class="center-box">
    <view class="center-title">排队中</view>
    <view class="center-sub">{{head}}</view>
  </view>
</view>
<view class="body" wx:elif="{{running}}">
  <view class="center-box">
    <view class="center-title">正在查询</view>
    <view class="center-sub">{{head}}</view>
  </view>
  <view class="bar-track"><view class="bar-fill" style="width: {{percent}}%;"></view></view>
</view>
<view class="body" wx:else>
  <view class="err-box" wx:if="{{showFailBanner}}">{{failBanner}}</view>
  <view class="note" wx:if="{{!showFailBanner}}">{{head}}</view>
  <view class="card" wx:for="{{items}}" wx:key="name">
    <view class="choice-top">
      <text class="row-title">{{item.name}}</text>
      <text class="tag {{item.badgeCls}}">{{item.badge}}</text>
    </view>
    <view class="ex-line">{{item.line}}</view>
    <view wx:if="{{item.hit}}" data-name="{{item.name}}" bindtap="openHit" class="link" style="text-align:left;">查看报告</view>
    <view class="choice-top" wx:if="{{item.missed}}" style="margin-top:16rpx;">
      <view class="btn ghost" style="width:48%;margin-top:0;" data-name="{{item.name}}" bindtap="requery">修改后重查</view>
      <view class="btn plain" style="width:48%;margin-top:0;" data-name="{{item.name}}" bindtap="evidence">申请取证</view>
    </view>
    <view class="btn" wx:if="{{item.failed && itemRetry}}" data-name="{{item.name}}" bindtap="retry">重试</view>
  </view>
  <view class="btn block" wx:if="{{showRetryAll}}" bindtap="retryAll">全部重试</view>
</view>
