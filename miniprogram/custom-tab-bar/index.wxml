<view class="bar">
  <view class="item" wx:for="{{list}}" wx:key="text" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <image class="icon" src="{{selected == index ? item.iconOn : item.icon}}" />
    <text class="label {{selected == index ? 'on' : ''}}">{{item.text}}</text>
  </view>
</view>
