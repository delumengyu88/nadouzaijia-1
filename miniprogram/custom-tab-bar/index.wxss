/* app.wxss 把 view 设成 border-box。高度含安全区，扣掉 padding 后内容区才是 50px。 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  box-sizing: border-box;
  height: calc(50px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: inset 0 1px 0 #eef1f4;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 50px;
}

.icon {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.label {
  margin-top: 2px;
  font-size: 10px;
  line-height: 1.2;
  flex-shrink: 0;
  color: #8a93a3;
}

.label.on {
  color: #1D4E9E;
}
