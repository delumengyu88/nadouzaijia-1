/* 结果页「已可看」命中行：首页最近查询与详情页共用。 */
.tl-rec { border-top: 1px solid #edf0f4; margin-top: 18rpx; padding-top: 18rpx; }
.tl-rec-top { display: flex; justify-content: space-between; align-items: baseline; }
.tl-platform { flex-shrink: 0; max-width: 55%; font-size: 28rpx; font-weight: 600; color: #1c2430; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tl-subtype { font-weight: 400; color: #646a73; font-size: 24rpx; }
.tl-meta { flex: 1; min-width: 0; margin-left: 16rpx; text-align: right; font-size: 24rpx; color: #8b95a3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tl-rec-sub { display: flex; justify-content: space-between; margin-top: 6rpx; font-size: 24rpx; color: #8b95a3; }
.tl-shots { display: flex; margin-top: 14rpx; }
.tl-shot { position: relative; width: 300rpx; height: 168rpx; flex-shrink: 0; border-radius: 12rpx; overflow: hidden; background: #d5dde8; }
.tl-img { width: 100%; height: 100%; }
.tl-ph { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: #c9d4e2; background-image: repeating-linear-gradient(45deg, #d7dfea 0 10rpx, #c9d4e2 10rpx 20rpx); }
.tl-shot.blur .tl-ph { filter: blur(2px); }
.tl-wm { position: absolute; right: 10rpx; bottom: 6rpx; font-size: 18rpx; color: rgba(255,255,255,.85); }
.tl-times { flex: 1; min-width: 0; margin-left: 20rpx; }
.tl-times-label { font-size: 22rpx; color: #8b95a3; }
.tl-time { margin-top: 6rpx; font-size: 24rpx; color: #1c2430; font-family: Menlo, monospace; }
