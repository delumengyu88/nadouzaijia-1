# Copy to .env for local overrides. Placeholders only — do not commit real passwords.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/nadou
APP_ENV=local
# Required to run python -m nadou.seed, which creates a fixed local VIP user id.
# Leave unset anywhere except a local database. X-User-Id is ignored in every environment.
# NADOU_ALLOW_DEV_SEED=1
# DingTalk robot for workbench alerts. Leave empty to disable. Never commit a real URL or secret.
NADOU_DINGTALK_WEBHOOK_URL=
NADOU_DINGTALK_WEBHOOK_SECRET=
# Local CSV for `python -m nadou index-run`. The private-storage reader is not in this slice.
NADOU_TASK_EXPORT_PATH=

NADOU_TRUSTED_PROXIES=127.0.0.1

# WeChat mini program login; set only in the server environment.
# NADOU_WX_APPID is also the AppID for JSAPI payment.
NADOU_WX_APPID=
NADOU_WX_APPSECRET=

# WeChat Pay APIv3. Empty values leave payment unconfigured. No real secrets here.
NADOU_WECHAT_MCH_ID=
NADOU_WECHAT_API_V3_KEY=
NADOU_WECHAT_MCH_PRIVATE_KEY_PATH=
NADOU_WECHAT_MCH_CERT_SERIAL=
NADOU_WECHAT_PAY_PUBLIC_KEY_PATH=
NADOU_WECHAT_PAY_PUBLIC_KEY_ID=
NADOU_WECHAT_NOTIFY_URL=
NADOU_WECHAT_PAY_TEST_TIER=0
NADOU_WECHAT_PAY_TEST_USERS=
# Experience-build tier switch. Production must stay 0. Only the exact value 1 enables it.
# Also requires NADOU_WECHAT_PAY_TEST_TIER=1, so those users see the 0.01 yuan tier.
# Switching a tier expires that account's live membership immediately, including a real
# paid one, and does not restore the old expiry. Put only test user ids in the list above.
# Before review, set this back to 0 and delete the route. Leave membership_dev in
# TEST_PRODUCTS and ck_orders_product so existing rows stay out of paid conversion.
NADOU_TRIAL_TOOLS=0
# Hit frames from W2's private COS export (read-only sub-account). Leave any of the five
# NADOU_FRAMES_COS_* values empty and no frames are served (frames_ready=false, 「暂无截图」).
# PREFIX is the W2 export prefix that holds frames_manifest.json and frames/.
NADOU_FRAMES_COS_SECRET_ID=
NADOU_FRAMES_COS_SECRET_KEY=
NADOU_FRAMES_COS_BUCKET=
NADOU_FRAMES_COS_REGION=
NADOU_FRAMES_COS_PREFIX=
# Local disk cache for frame bytes; mount a volume here to keep it across restarts.
NADOU_FRAMES_CACHE_DIR=/tmp/nadou-frames
NADOU_FRAMES_CACHE_MAX_MB=2048
