# W2 索引同步拉取器 配置（systemd EnvironmentFile 格式，不支持 export 前缀）
# 复制为 config.env 后填入实际值，权限 600（chmod 600 config.env）
# 钥匙由运维从安全渠道获取，禁止聊天明文传递。

# 腾讯云 COS 只读子账号（w2-idx-readonly，限定 w2-index-export/ 目录）
W2_COS_SECRET_ID=""
W2_COS_SECRET_KEY=""
W2_COS_BUCKET=""
W2_COS_REGION="ap-beijing"
W2_COS_PREFIX="w2-index-export"

# 本地数据目录（current 软链指向当前生效版本）
W2_DATA_DIR="/var/lib/w2-index"
# 保留最近版本数
W2_KEEP="3"
# 日志文件（systemd LogsDirectory 已把 /var/log/w2-sync-puller 归 w2sync 所有）
W2_LOG_FILE="/var/log/w2-sync-puller/sync_puller.log"

# 钉钉机器人 webhook（发「视频消消乐」群，用于同步告警）
W2_DINGTALK_WEBHOOK=""
