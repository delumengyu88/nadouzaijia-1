# W2 导入（宿主机 root 运行）配置，systemd EnvironmentFile 格式，不要写 export
# 这里只有路径，没有密码；数据库密码在线上 .env 里，导入程序在 api 容器内读取

# 线上部署目录（里面有 compose 文件和线上 .env）
NADOU_DEPLOY_DIR=""
NADOU_COMPOSE_FILE="compose.prod.yml"
NADOU_ENV_FILE=".env.prod"
NADOU_COMPOSE_PROJECT="nadou"
NADOU_API_SERVICE="api"

# 拉取器的数据目录（只读挂进容器）
W2_DATA_DIR="/var/lib/w2-index"
# 导入状态文件目录
W2_IMPORT_STATE_DIR="/var/lib/w2-import"
